{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-clean-kefu",
  "main": "src/server.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ChatAgent",
        "class_name": "CleanAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CleanAgent"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  }
}
